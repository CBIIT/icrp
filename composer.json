{
  "name": "cbiit/icrp",
  "description": "Website for International Cancer Research Project",
  "minimum-stability": "alpha",
  "prefer-stable": true,
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  },
  "require": {
    "composer-plugin-api": "*",
    "box/spout": "^3.3",
    "composer/installers": "^2.0",
    "cweagans/composer-patches": "^1.7",
    "drupal/admin_toolbar": "^3.4",
    "drupal/admin_toolbar_tools": "^3.4",
    "drupal/advanced_help_hint": "^2.0",
    "drupal/autologout": "^2.0",
    "drupal/backup_migrate": "^5.0",
    "drupal/bartik":"^1.0",
    "drupal/bootstrap": "^5",
    "drupal/bootstrap_layouts": "^5.2",
    "drupal/captcha": "^1.3",
    "drupal/clientside_validation": "^4.1",
    "drupal/clientside_validation_jquery": "^3.0",
    "drupal/composer_deploy": "^1.6",
    "drupal/core-composer-scaffold": "^10.3",
    "drupal/core-project-message": "^10.3",
    "drupal/core-recommended": "^10.3",
    "drupal/ckeditor_lts":"^1.0",
    "drupal/quickedit":"^1.0",
    "drupal/crop": "^2.1",
    "drupal/csv_serialization": "^4.0",
    "drupal/ctools": "^3.0",
    "drupal/datatables": "^2.0",
    "drupal/devel": "^5.1",
    "drupal/ds": "^3.30",
    "drupal/ds_extras": "^3.30",
    "drupal/ds_switch_view_mode": "^3.30",
    "drupal/editor_advanced_link": "^2.0",
    "drupal/email_registration": "^1.0",
    "drupal/embed": "^1.3",
    "drupal/entity": "^1.3",
    "drupal/entity_embed": "^1.1",
    "drupal/extlink": "^2.0",
    "drupal/faq": "^1.0",
    "drupal/field_permissions": "^1.1",
    "drupal/focal_point": "^2.0",
    "drupal/fontawesome": "^2.24",
    "drupal/fullcalendar": "^3.0",
    "drupal/google_analytics": "^4.0",
    "drupal/honeypot": "^2.1.4",
    "drupal/linkit": "^7.0",
    "drupal/metatag": "^2.2",
    "drupal/panels_ipe": "^4.7",
    "drupal/pathauto": "^1.11",
    "drupal/recaptcha": "^3.1",
    "drupal/redirect": "^1.9",
    "drupal/redirect_after_login": "^3.0",
    "drupal/rdf":"^2.1",
    "drupal/rules": "^4.0",
    "drupal/search_exclude": "^3.0@beta",
    "drupal/seven":"^1.0",
    "drupal/token": "^1.13",
    "drupal/twig_tweak": "^3.4",
    "drupal/typed_data": "^2.1",
    "drupal/upgrade_rector": "^2.0@alpha",
    "drupal/upgrade_status": "^4.1",
    "drupal/video_embed_field": "^2.5",
    "drupal/views_bootstrap": "^5.0",
    "drupal/views_data_export": "^1.1",
    "drupal/views_templates": "^1.1",
    "drupal/webform": "^6.3",
    "drupal/webform_ui": "^6.3",
    "drupal/webform_views": "^5.0",
    "drupal/yaml_content": "^1.0",
    "drush/drush": "^12.4",
    "league/csv": "^9.1",
    "maennchen/zipstream-php": "^2.2",
    "phpmailer/phpmailer": "^6.9",
    "phpoffice/phpspreadsheet": "^1.29",
    "phpstan/phpstan": "^1.12",
    "psr/log": "^3.0",
    "robloach/component-installer": "*",
    "select2/select2": "^4.0",
    "wikimedia/composer-merge-plugin": "*",
    "palantirnet/drupal-rector": "^0.15"
  },
  "conflict": {
    "drupal/drupal": "*",
    "drupal/console": "*"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "drupal/core-composer-scaffold": true,
      "drupal/core-project-message": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "oomphinc/composer-installers-extender": true,
      "cweagans/composer-patches": true,
      "wikimedia/composer-merge-plugin": true,
      "robloach/component-installer": true
    },
    "sort-packages": true,
    "discard-changes": true
  },
  "scripts": {
    "post-update-cmd": [
      "drush webform-libraries-download",
      "drush updatedb -y",
      "drush cr"
    ]
  },
  "extra": {
    "drupal-scaffold": {
      "locations": {
        "web-root": "./"
      }
    },
    "installer-paths": {
      "core": ["type:drupal-core"],
      "libraries/{$name}": ["type:drupal-library"],
      "modules/{$name}": ["type:drupal-module"],
      "profiles/{$name}": ["type:drupal-profile"],
      "themes/{$name}": ["type:drupal-theme"],
      "drush/contrib/{$name}": ["type:drupal-drush"]
    }
  }
}

