{#
/**
 * @file
 * Theme override to display a list of forums and containers.
 *
 * Available variables:
 * - forums: A collection of forums and containers to display.
 * - forum_id: Forum ID for the current forum.
 *
 * @see template_preprocess_forum_list()
 */
#}

{% if icrp_debug %}
  <span class="icrp-debug">forums-list.html.twig</span><br>
  Look at the console<br>
  <script>console.info("forums-list.html.twig");</script>
  <script>console.log({{ _context | json_encode | raw }});</script>
  <script>console.info("forums");</script>
  <script>console.log({{ forums | json_encode | raw }});</script>
{% endif %}

<table id="forum" class="table table-bordered table-striped table-condensed table-narrow">
  <thead>
    <tr>
      <th>{{ 'Forum'|t }}</th>
      <th style="text-align: center;" nowrap>{{ 'Threads'|t }} / {{ 'Posts'|t }}</th>
      <th>{{ 'Last Post'|t }}</th>
    </tr>
  </thead>

  <tbody>
  {% if icrp_debug %}
    <script>console.log({{ forums | json_encode | raw }});</script>
  {% endif %}

  {% for child_id, forum in forums %}

    {% if child_id == 1 %}
      {% set break = true %}
    {% endif %}

    <tr id="forum-list-{{ child_id }}" class="{{ forum.zebra }}">
      <td
        {% if forum.is_container %}
          colspan="4" class="container"
        {% else %}
          class="forum-list__forum"
        {% endif %}
      >

        {# Indentation wrappers based on depth #}
        {% if forum.depth > 0 %}
          {% for i in 1..forum.depth %}
            <div class="indented">
          {% endfor %}
        {% endif %}

        {# Set a unique icon for each forum-id #}
        {% if child_id == 7 %}
          {% set icon = "fa-newspaper-o" %}
        {% elseif child_id == 8 %}
          {% set icon = "fa-comments-o" %}
        {% elseif child_id == 9 %}
          {% set icon = "fa-group" %}
        {% elseif child_id == 10 %}
          {% set icon = "fa-file-code-o" %}
        {% elseif child_id == 11 %}
          {% set icon = "fa-dashboard" %}
        {% elseif child_id == 12 %}
          {% set icon = "fa-globe" %}
        {% elseif child_id == 13 %}
          {% set icon = "fa-database" %}
        {% elseif child_id == 27 %}
          {% set icon = "fa-money" %}
        {% else %}
          {% set icon = "fa-folder-open-o" %}
        {% endif %}

        {% if icrp_debug %}
          <script>console.log({{ forum | json_encode | raw }});</script>
        {% endif %}

        <div class="pull-left" data-forum-id="{{ child_id }}">
          <i class="fa {{ icon }} fa-2x"
             title="{{ forum.icon_title }}"
             style="margin: 0 10px 0 4px; color: steelblue;"></i>
        </div>

        <div class="forum__name">
          <a href="{{ forum.link }}">{{ forum.label }}</a>
        </div>

        {% if forum.description.value %}
          <div class="forum__description">{{ forum.description.value }}</div>
        {% endif %}

        {# Close indentation wrappers #}
        {% if forum.depth > 0 %}
          {% for i in 1..forum.depth %}</div>{% endfor %}
        {% endif %}

      </td>

      {% if not forum.is_container %}
        <td style="text-align: center; padding:15px;">
          <div id="forum_numbers">
            <span class="forum__topics" title="Number of threads in this forum.">
              {{ forum.num_topics }}
            </span>&nbsp;
            <span class="forum__posts" title="Number of posts in this forum.">
              {{ forum.num_posts }}
            </span>
          </div>

          {% if forum.new_topics %}
            <br>
            <div>
              <a href="{{ forum.new_url }}">{{ forum.new_text }}</a>
            </div>
          {% endif %}
        </td>

        <td class="last-reply" style="max-width:300px; overflow:hidden;">
          {% if forum.num_topics == 0 %}
            <span class="forum__last-reply" style="font-style:italic;">
              No Posts
            </span>
          {% else %}
            {% if loop.index == 1 %}
              {% set t = loop.index + 6 %}
            {% elseif loop.index == 2 %}
              {% set t = 27 %}
            {% else %}
              {% set t = loop.index + 5 %}
            {% endif %}

            {% if logged_in %}
              <div style="margin-bottom:10px;">
                {{ tforums[t].last_post | raw }}
              </div>
              <div class="forum__last-reply">
                {{ forum.last_reply | raw }}
                <span class="pull-right">
                  <a href="/node/{{ tforums[t].nid }}#latest">View this post</a>
                </span>
              </div>
            {% endif %}
          {% endif %}
        </td>
      {% endif %}
    </tr>
  {% endfor %}
  </tbody>
</table>
